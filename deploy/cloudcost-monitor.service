[Unit]
Description=CloudCost monthly unbilled cost monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudcost
Group=cloudcost
WorkingDirectory=/opt/cloudcost
EnvironmentFile=-/etc/cloudcost/cloudcost.env
ExecStart=/opt/cloudcost/.venv/bin/cloudcost run -c /etc/cloudcost/config.toml
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target

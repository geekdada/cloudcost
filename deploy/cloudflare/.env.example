# CloudCost SPA/API access token: generate with openssl rand -hex 32.
# This is separate from the Cloudflare API token.
CLOUDCOST_API_TOKEN=
CLOUDCOST_PORT=8765

# Cloudflare Account > Billing > Read, scoped to this account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# USD thresholds. Only Cloudflare is enabled in this Compose deployment.
CLOUDCOST_TOTAL_BUDGET=100
CLOUDFLARE_BUDGET=100

# Sum of all fixed monthly subscription fees in USD; set 0 only if none.
# Metered usage costs are collected separately by the official API.
CLOUDFLARE_FIXED_MONTHLY_COST=

# Optional: uncomment the Slack channel block in compose.yml to enable it.
# SLACK_WEBHOOK_URL=
